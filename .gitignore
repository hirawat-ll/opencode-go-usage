# Dependencies and build output
node_modules
dist
src-tauri/target
src-tauri/gen

# Secrets — the app handles API keys, so keep any local env file out of the repo.
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes

# Editors
.vscode
.idea

# Logs and coverage
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.profraw
lcov.info
coverage

# Rust
**/*.rs.bk

# Stray build artifacts, if someone drops one next to the source
*.dmg
*.app

# Regenerated by `npm run icons`; only the macOS art is kept in the repo.
src-tauri/icons/android
src-tauri/icons/ios
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png
